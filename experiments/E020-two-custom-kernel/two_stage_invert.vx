#include "cl_viv_vx_ext.h"

#define INVERT_STAGE(kernel_name) \
__kernel void kernel_name( \
    __read_only image2d_t input, \
    __write_only image2d_t output) \
{ \
    const int2 coord = (int2)((int)get_global_id(0) * 16, 0); \
    vxc_uchar16 value; \
    VXC_ReadImage(value, input, coord, VXC_5BITOFFSET_XY(0, 0), \
                  VXC_MODIFIER(0, 15, 0, VXC_RM_TowardZero, 0)); \
    value ^= (vxc_uchar16)(255); \
    VXC_WriteImage(output, coord, value, \
                   VXC_MODIFIER(0, 15, 0, VXC_RM_TowardZero, 0)); \
}

INVERT_STAGE(e020_invert_stage_a)
INVERT_STAGE(e020_invert_stage_b)
