+
+// E032 candidate: one noinline call consumes the four Q8 blocks that belong
+// to one Q1 row-group.  This keeps only one output accumulator live and makes
+// the call overhead one per 512 input values, not one per 128-value fragment.
+#if defined(__GNUC__) || defined(__clang__)
+#define GGML_Q1_E032_NOINLINE __attribute__((__noinline__))
+#else
+#define GGML_Q1_E032_NOINLINE
+#endif
+static GGML_Q1_E032_NOINLINE float32x4_t ggml_q1_0_dot_block4(
+        const block_q1_0x4 * GGML_RESTRICT b_ptr,
+        const block_q8_0 * GGML_RESTRICT a_ptr) {
+    float32x4_t accb = vdupq_n_f32(0);
+
+    for (int k = 0; k < 4; ++k) {
+        const block_q8_0 * GGML_RESTRICT a_blk = a_ptr + k;
+        const uint8_t * GGML_RESTRICT b_qs = (const uint8_t *) b_ptr->qs + k * 16;
+        const float ad = GGML_CPU_FP16_TO_FP32(a_blk->d);
+        const int8x16_t q0 = vld1q_s8(a_blk->qs + 0);
+        const int8x16_t q1 = vld1q_s8(a_blk->qs + 16);
+        int32x4_t ret = vdupq_n_s32(0);
+
+        for (int tile = 0; tile < 4; ++tile) {
+            ret = vdotq_laneq_s32(ret,
+                ggml_q1_0_unpack_pair(b_qs[2 * tile], b_qs[2 * tile + 1]),
+                q0, tile);
+        }
+        for (int tile = 4; tile < 8; ++tile) {
+            ret = vdotq_laneq_s32(ret,
+                ggml_q1_0_unpack_pair(b_qs[2 * tile], b_qs[2 * tile + 1]),
+                q1, tile - 4);
+        }
+        accb = vfmaq_n_f32(accb, vcvtq_f32_s32(ret), ad);
+    }
+
+    return accb;
+}
 #endif
 
