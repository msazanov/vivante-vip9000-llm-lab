index 0000000..6b697ba
--- /dev/null
+++ b/ggml/src/ggml-cpu/arch/arm/repack-a76.h
@@ -0,0 +1,58 @@
+#pragma once
+
+#include <cstddef>
+#include <cstring>
+
+#include "ggml.h"
+
+enum class ggml_q1_a76_dispatch_mode : unsigned char {
+    stock,
+    null_dispatch,
+    candidate,
+};
+
+using ggml_q1_gemv_function = void (*)(
+    int,
+    float * GGML_RESTRICT,
+    size_t,
+    const void * GGML_RESTRICT,
+    const void * GGML_RESTRICT,
+    int,
+    int);
+
+inline ggml_q1_a76_dispatch_mode ggml_q1_a76_parse_dispatch_mode(const char * value) {
+    if (value != nullptr && std::strcmp(value, "null") == 0) {
+        return ggml_q1_a76_dispatch_mode::null_dispatch;
+    }
+    if (value != nullptr && std::strcmp(value, "candidate") == 0) {
+        return ggml_q1_a76_dispatch_mode::candidate;
+    }
+    return ggml_q1_a76_dispatch_mode::stock;
+}
+
+inline ggml_q1_gemv_function ggml_q1_a76_resolve_kernel(
+    ggml_q1_a76_dispatch_mode mode,
+    int current_cpu,
+    ggml_q1_gemv_function stock,
+    ggml_q1_gemv_function a76) {
+    const bool on_a76 = current_cpu == 6 || current_cpu == 7;
+    return mode == ggml_q1_a76_dispatch_mode::candidate && on_a76 ? a76 : stock;
+}
+
+void ggml_gemv_q1_0_4x4_q8_0_stock(
+    int n,
+    float * GGML_RESTRICT s,
+    size_t bs,
+    const void * GGML_RESTRICT vx,
+    const void * GGML_RESTRICT vy,
+    int nr,
+    int nc);
+
+void ggml_gemv_q1_0_4x4_q8_0_a76(
+    int n,
+    float * GGML_RESTRICT s,
+    size_t bs,
+    const void * GGML_RESTRICT vx,
+    const void * GGML_RESTRICT vy,
+    int nr,
+    int nc);
