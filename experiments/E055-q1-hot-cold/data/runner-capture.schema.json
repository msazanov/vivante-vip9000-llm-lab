{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/msazanov/vivante-vip9000-llm-lab/e055-runner-capture/v1",
  "title": "E055 runner capture metadata",
  "type": "object",
  "required": [
    "schema", "run_id", "pair_id", "pair_index", "pair_order",
    "order_index", "build_name", "argv", "environment", "affinity",
    "exit", "provenance", "artifact_sha256", "target_workload_executed"
  ],
  "properties": {
    "schema": {"const": "e055-runner-capture/v1"},
    "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "pair_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "pair_index": {"type": "integer", "minimum": 1, "maximum": 5},
    "pair_order": {"enum": ["hot_then_cold", "cold_then_hot"]},
    "order_index": {"enum": [1, 2]},
    "build_name": {"enum": ["O3", "O3-flto"]},
    "argv": {
      "type": "array", "minItems": 16, "maxItems": 32,
      "items": {"type": "string", "minLength": 1, "maxLength": 1024}
    },
    "environment": {
      "type": "object",
      "required": ["LC_ALL", "LANG", "E055_BUILD_NAME"],
      "properties": {
        "LC_ALL": {"const": "C"},
        "LANG": {"const": "C"},
        "E055_BUILD_NAME": {"enum": ["O3", "O3-flto"]}
      },
      "additionalProperties": false
    },
    "affinity": {
      "type": "object",
      "required": ["requested_cpus", "effective_cpus", "cpu_start", "cpu_end", "migration_count"],
      "properties": {
        "requested_cpus": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"enum": [0, 6]}},
        "effective_cpus": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"enum": [0, 6]}},
        "cpu_start": {"enum": [0, 6]},
        "cpu_end": {"enum": [0, 6]},
        "migration_count": {"const": 0}
      },
      "additionalProperties": false
    },
    "exit": {
      "type": "object",
      "required": ["code", "signal"],
      "properties": {"code": {"const": 0}, "signal": {"type": "null"}},
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": [
        "source_sha256", "binary_sha256", "compiler_sha256", "compiler_id",
        "pmu_source_sha256", "upstream_commit", "upstream_ref",
        "upstream_repack_sha256", "publication_manifest_sha256"
      ],
      "properties": {
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "binary_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "compiler_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "compiler_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "pmu_source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "upstream_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "upstream_ref": {"type": "string", "minLength": 1, "maxLength": 512},
        "upstream_repack_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "publication_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "artifact_sha256": {
      "type": "object",
      "required": ["harness_stdout", "harness_stderr", "e049c_json", "e049c_stderr"],
      "properties": {
        "harness_stdout": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "harness_stderr": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "e049c_json": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "e049c_stderr": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "target_workload_executed": {"const": true}
  },
  "additionalProperties": false
}
