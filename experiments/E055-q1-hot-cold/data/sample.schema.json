{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/msazanov/vivante-vip9000-llm-lab/e055-derived-sample/v1",
  "title": "E055 analyzer-derived sample",
  "description": "Publication shape for a row derived from a committed Git-sealed raw bundle. This schema is not an analyzer input contract.",
  "x-e055-analyzer-input": false,
  "type": "object",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^(?!0{64}$)[0-9a-f]{64}$"},
    "git_oid": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "raw_artifact": {
      "type": "object",
      "required": ["role", "relative_path", "sha256", "size_bytes", "git_blob_oid"],
      "properties": {
        "role": {"enum": ["harness_stdout", "harness_stderr", "e049c_json", "e049c_stderr", "runner_metadata"]},
        "relative_path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$", "maxLength": 4096},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "git_blob_oid": {"$ref": "#/$defs/git_oid"}
      },
      "additionalProperties": false
    },
    "pmu_event": {
      "type": "object",
      "required": ["name", "config", "value", "time_enabled_ns", "time_running_ns", "running_ratio"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "config": {"enum": ["0x11", "0x8", "0x24", "0x3", "0x17", "0x2a", "0x13", "0x19"]},
        "value": {"type": "integer", "minimum": 0},
        "time_enabled_ns": {"type": "integer", "minimum": 1},
        "time_running_ns": {"type": "integer", "minimum": 1},
        "running_ratio": {"type": "number", "const": 1.0}
      },
      "additionalProperties": false
    }
  },
  "required": [
    "schema", "run_id", "pair_id", "pair_index", "pair_order", "order_index",
    "build_name", "mode", "cache_state", "cpu", "target_working_set_bytes",
    "actual_working_set_bytes", "blocks", "iterations", "calls", "elapsed_ns",
    "checksum", "pmu_group", "measured_elapsed_ns", "thermal_limit_c",
    "max_temp_c", "pmu_events", "golden_pass", "golden_cases", "evidence"
  ],
  "properties": {
    "schema": {"const": "e055-derived-sample/v1"},
    "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "pair_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "pair_index": {"type": "integer", "minimum": 1, "maximum": 5},
    "pair_order": {"enum": ["hot_then_cold", "cold_then_hot"]},
    "order_index": {"enum": [1, 2]},
    "build_name": {"enum": ["O3", "O3-flto"]},
    "mode": {"enum": ["packed_stream", "unpack_scale", "full_dotprod"]},
    "cache_state": {"enum": ["hot_repeat", "cold_conditioned"]},
    "cpu": {"enum": [0, 6]},
    "target_working_set_bytes": {"enum": [65536, 131072, 262144, 524288, 1048576, 4194304, 13107200]},
    "actual_working_set_bytes": {"type": "integer", "minimum": 1},
    "blocks": {"type": "integer", "minimum": 1},
    "iterations": {"type": "integer", "minimum": 1},
    "calls": {"type": "integer", "minimum": 1},
    "elapsed_ns": {"type": "integer", "minimum": 1},
    "checksum": {"type": "string", "pattern": "^0x(?!0+$)[0-9a-f]+$"},
    "pmu_group": {"enum": ["core", "cache", "memory"]},
    "measured_elapsed_ns": {"type": "integer", "minimum": 1},
    "thermal_limit_c": {"type": "number"},
    "max_temp_c": {"type": "number"},
    "pmu_events": {"type": "array", "minItems": 2, "maxItems": 3, "items": {"$ref": "#/$defs/pmu_event"}},
    "golden_pass": {"const": true},
    "golden_cases": {"const": 18},
    "evidence": {
      "type": "object",
      "required": ["commit", "tree", "manifest_path", "manifest_blob_oid", "publication_identity", "raw_artifacts"],
      "properties": {
        "commit": {"$ref": "#/$defs/git_oid"},
        "tree": {"$ref": "#/$defs/git_oid"},
        "manifest_path": {"type": "string", "pattern": "^experiments/E055-q1-hot-cold/raw/[a-z0-9][a-z0-9._-]{0,127}/bundle\\.json$"},
        "manifest_blob_oid": {"$ref": "#/$defs/git_oid"},
        "publication_identity": {"type": "object", "minProperties": 9, "additionalProperties": {"type": "string"}},
        "raw_artifacts": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"$ref": "#/$defs/raw_artifact"}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
