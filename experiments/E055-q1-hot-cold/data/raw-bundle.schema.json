{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/msazanov/vivante-vip9000-llm-lab/e055-raw-bundle/v2",
  "title": "E055 Git-sealed raw measurement bundle",
  "type": "object",
  "$defs": {
    "artifact": {
      "type": "object",
      "required": ["role", "path", "sha256", "size_bytes", "git_blob_oid"],
      "properties": {
        "role": {
          "enum": [
            "harness_executable", "harness_stdout", "harness_stderr",
            "e049c_json", "e049c_stderr", "runner_metadata"
          ]
        },
        "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$", "maxLength": 4096},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 1, "maximum": 33554432},
        "git_blob_oid": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"}
      },
      "additionalProperties": false
    },
    "transportObservation": {
      "type": "object",
      "required": ["role", "target_path", "sha256", "size_bytes", "mode", "device", "inode", "operation_sequence", "request_id", "request_nonce"],
      "properties": {
        "role": {"enum": ["harness_executable", "pmu_executable"]},
        "target_path": {"type": "string", "pattern": "^/tmp/e055-q1-hot-cold/deployments/[0-9a-f]{64}/artifacts/[0-9a-f]{64}/[A-Za-z0-9._-]+$", "maxLength": 4096},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 1, "maximum": 33554432},
        "mode": {"const": 493},
        "device": {"type": "integer", "minimum": 0},
        "inode": {"type": "integer", "minimum": 1},
        "operation_sequence": {"enum": [1, 2]},
        "request_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "request_nonce": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "remoteRuntimeObservation": {
      "type": "object",
      "required": [
        "schema", "operation_sequence", "request_id", "request_nonce",
        "helper_path", "helper_sha256", "helper_size_bytes", "helper_mode",
        "helper_device", "helper_inode", "helper_protocol",
        "python_requested_path", "python_realpath", "python_version",
        "python_sha256", "python_size_bytes", "python_mode",
        "python_device", "python_inode"
      ],
      "properties": {
        "schema": {"const": "e055-remote-runtime-observation/v1"},
        "operation_sequence": {"enum": [1, 2]},
        "request_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "request_nonce": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "helper_path": {"type": "string", "pattern": "^/tmp/e055-q1-hot-cold/helpers/[0-9a-f]{64}/helper\\.py$"},
        "helper_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "helper_size_bytes": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "helper_mode": {"const": 448},
        "helper_device": {"type": "integer", "minimum": 0},
        "helper_inode": {"type": "integer", "minimum": 1},
        "helper_protocol": {"const": "e055-remote-helper/v1"},
        "python_requested_path": {"const": "/usr/bin/python3"},
        "python_realpath": {"type": "string", "pattern": "^/usr/bin/python3(?:\\.[0-9]+)?$"},
        "python_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+[A-Za-z0-9.+-]{0,32}$"},
        "python_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "python_size_bytes": {"type": "integer", "minimum": 1, "maximum": 134217728},
        "python_mode": {"const": 493},
        "python_device": {"type": "integer", "minimum": 0},
        "python_inode": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "transportImplementation": {
      "type": "object",
      "required": [
        "schema", "implementation", "helper_source_path", "helper_source_sha256",
        "helper_source_size_bytes", "helper_git_blob_oid", "openssh_path",
        "openssh_sha256", "openssh_size_bytes", "openssh_mode", "openssh_version",
        "config_file", "client_config", "client_config_sha256",
        "known_hosts_sha256", "target_endpoint_sha256", "credential_mode"
      ],
      "properties": {
        "schema": {"const": "e055-openssh-implementation/v1"},
        "implementation": {"const": "openssh_fixed_helper"},
        "helper_source_path": {"const": "tooling/e055_remote_helper.py"},
        "helper_source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "helper_source_size_bytes": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "helper_git_blob_oid": {"type": "string", "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$"},
        "openssh_path": {"type": "string", "pattern": "^/[A-Za-z0-9._/-]+/ssh$", "maxLength": 4096},
        "openssh_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "openssh_size_bytes": {"type": "integer", "minimum": 1, "maximum": 33554432},
        "openssh_mode": {"const": 493},
        "openssh_version": {"type": "string", "pattern": "^OpenSSH_[A-Za-z0-9._,+-]{1,96}$"},
        "config_file": {"const": "/dev/null"},
        "client_config": {"type": "array", "minItems": 21, "maxItems": 21, "uniqueItems": true, "items": {"type": "string", "minLength": 3, "maxLength": 128}},
        "client_config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "known_hosts_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "target_endpoint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "credential_mode": {"const": "external_agent_or_identity"}
      },
      "additionalProperties": false
    },
    "expectedTransportPins": {
      "type": "object",
      "required": [
        "schema", "trust_mode", "endpoint_label", "board_identity",
        "host_key_fingerprint", "known_hosts_sha256", "target_endpoint_sha256",
        "helper_source_sha256", "helper_source_size_bytes", "helper_git_blob_oid",
        "openssh_sha256", "openssh_size_bytes"
      ],
      "properties": {
        "schema": {"const": "e055-expected-transport-pins/v1"},
        "trust_mode": {"const": "pinned_host_key"},
        "endpoint_label": {"type": "string", "minLength": 1, "maxLength": 128},
        "board_identity": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "host_key_fingerprint": {"type": "string", "pattern": "^SHA256:[A-Za-z0-9+/]{43}$"},
        "known_hosts_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "target_endpoint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "helper_source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "helper_source_size_bytes": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "helper_git_blob_oid": {"type": "string", "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$"},
        "openssh_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "openssh_size_bytes": {"type": "integer", "minimum": 1, "maximum": 33554432}
      },
      "additionalProperties": false
    },
    "transportEvidence": {
      "type": "object",
      "required": ["schema", "trust_statement", "endpoint_identity", "expected_pins", "implementation_evidence", "deployment_root", "lock_path", "requests", "exclusive_receipt", "fresh_readback"],
      "properties": {
        "schema": {"const": "e055-transport-evidence/v2"},
        "trust_statement": {"const": "replay-resistant transport evidence only; no cryptographic device attestation; transport and endpoint remain operationally trusted"},
        "endpoint_identity": {
          "type": "object",
          "required": ["trust_mode", "endpoint_label", "board_identity", "host_key_fingerprint"],
          "properties": {
            "trust_mode": {"const": "pinned_host_key"},
            "endpoint_label": {"type": "string", "minLength": 1, "maxLength": 256},
            "board_identity": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "host_key_fingerprint": {"type": "string", "pattern": "^SHA256:[A-Za-z0-9+/]{43}$"}
          },
          "additionalProperties": false
        },
        "expected_pins": {"$ref": "#/$defs/expectedTransportPins"},
        "implementation_evidence": {"$ref": "#/$defs/transportImplementation"},
        "deployment_root": {"type": "string", "pattern": "^/tmp/e055-q1-hot-cold/deployments/[0-9a-f]{64}$"},
        "lock_path": {"const": "/tmp/e055-q1-hot-cold/locks/a733-target.lock"},
        "requests": {
          "type": "object",
          "required": ["exclusive_deploy", "fresh_readback"],
          "properties": {
            "exclusive_deploy": {
              "type": "object",
              "required": ["operation_sequence", "request_id", "request_nonce"],
              "properties": {
                "operation_sequence": {"const": 1},
                "request_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "request_nonce": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              },
              "additionalProperties": false
            },
            "fresh_readback": {
              "type": "object",
              "required": ["operation_sequence", "request_id", "request_nonce"],
              "properties": {
                "operation_sequence": {"const": 2},
                "request_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "request_nonce": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "exclusive_receipt": {
          "type": "object",
          "required": ["schema", "operation_sequence", "request_id", "request_nonce", "lock_acquired_exclusively", "deployment_created_exclusively", "endpoint_identity", "artifacts", "runtime"],
          "properties": {
            "schema": {"const": "e055-exclusive-deployment-receipt/v1"},
            "operation_sequence": {"const": 1},
            "request_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "request_nonce": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "lock_acquired_exclusively": {"const": true},
            "deployment_created_exclusively": {"const": true},
            "endpoint_identity": {"$ref": "#/$defs/transportEvidence/properties/endpoint_identity"},
            "artifacts": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/transportObservation"}},
            "runtime": {"$ref": "#/$defs/remoteRuntimeObservation"}
          },
          "additionalProperties": false
        },
        "fresh_readback": {
          "type": "object",
          "required": ["schema", "operation_sequence", "request_id", "request_nonce", "endpoint_identity", "artifacts", "runtime"],
          "properties": {
            "schema": {"const": "e055-fresh-readback-proof/v1"},
            "operation_sequence": {"const": 2},
            "request_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "request_nonce": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "endpoint_identity": {"$ref": "#/$defs/transportEvidence/properties/endpoint_identity"},
            "artifacts": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/transportObservation"}},
            "runtime": {"$ref": "#/$defs/remoteRuntimeObservation"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "cell": {
      "type": "object",
      "required": [
        "mode", "cache_state", "cpu", "target_working_set_bytes",
        "actual_working_set_bytes", "blocks", "pmu_group"
      ],
      "properties": {
        "mode": {"enum": ["packed_stream", "unpack_scale", "full_dotprod"]},
        "cache_state": {"enum": ["hot_repeat", "cold_conditioned"]},
        "cpu": {"enum": [0, 6]},
        "target_working_set_bytes": {"enum": [65536, 131072, 262144, 524288, 1048576, 4194304, 13107200]},
        "actual_working_set_bytes": {"type": "integer", "minimum": 1},
        "blocks": {"type": "integer", "minimum": 1},
        "pmu_group": {"enum": ["core", "cache", "memory"]}
      },
      "additionalProperties": false
    }
  },
  "required": [
    "schema", "experiment", "phase_id", "qualification",
    "build_artifacts", "runs", "transport_evidence", "target_workload_executed"
  ],
  "properties": {
    "schema": {"const": "e055-raw-bundle/v2"},
    "experiment": {"const": "E055-Q1-HOT-COLD"},
    "phase_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "qualification": {
      "type": "object",
      "required": [
        "source_sha256", "compiler_sha256", "compiler_id", "pmu_source_sha256",
        "pmu_binary_sha256", "pmu_binary_size_bytes", "pmu_compiler_sha256", "pmu_compiler_id",
        "upstream_commit", "upstream_ref", "upstream_repack_sha256",
        "runtime_qualification_sha256"
      ],
      "properties": {
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "compiler_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "compiler_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "pmu_source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "pmu_binary_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "pmu_binary_size_bytes": {"type": "integer", "minimum": 1, "maximum": 33554432},
        "pmu_compiler_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "pmu_compiler_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "upstream_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "upstream_ref": {"type": "string", "minLength": 1, "maxLength": 512},
        "upstream_repack_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "runtime_qualification_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "build_artifacts": {
      "type": "array", "minItems": 1, "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["build_name", "artifact"],
        "properties": {
          "build_name": {"enum": ["O3", "O3-flto"]},
          "artifact": {"$ref": "#/$defs/artifact"}
        },
        "additionalProperties": false
      }
    },
    "runs": {
      "type": "array", "minItems": 1, "maxItems": 1260,
      "items": {
        "type": "object",
        "required": [
          "run_id", "pair_id", "pair_index", "pair_order", "order_index",
          "build_name", "cell", "artifacts"
        ],
        "properties": {
          "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
          "pair_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
          "pair_index": {"type": "integer", "minimum": 1, "maximum": 5},
          "pair_order": {"enum": ["hot_then_cold", "cold_then_hot"]},
          "order_index": {"enum": [1, 2]},
          "build_name": {"enum": ["O3", "O3-flto"]},
          "cell": {"$ref": "#/$defs/cell"},
          "artifacts": {
            "type": "object",
            "required": ["harness_stdout", "harness_stderr", "e049c_json", "e049c_stderr", "runner_metadata"],
            "properties": {
              "harness_stdout": {"$ref": "#/$defs/artifact"},
              "harness_stderr": {"$ref": "#/$defs/artifact"},
              "e049c_json": {"$ref": "#/$defs/artifact"},
              "e049c_stderr": {"$ref": "#/$defs/artifact"},
              "runner_metadata": {"$ref": "#/$defs/artifact"}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "transport_evidence": {"$ref": "#/$defs/transportEvidence"},
    "target_workload_executed": {"const": true}
  },
  "additionalProperties": false
}
