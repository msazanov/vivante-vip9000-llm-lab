+// E030: decode one Q1 row-group against both halves of one Q8 block.  Keeping
+// q0/q1 in registers lets two adjacent row-groups reuse the same activation
+// bytes without changing the packed Q1 representation or the dot-product
+// order used by the reference kernel.
+static inline int32x4_t ggml_q1_0_dot_block_reuse(const uint8_t * GGML_RESTRICT b_qs,
+                                                   int8x16_t q0,
+                                                   int8x16_t q1) {
+    int32x4_t ret = vdupq_n_s32(0);
+
+    for (int tile = 0; tile < 4; ++tile) {
+        const int8x16_t signs = ggml_q1_0_unpack_pair(b_qs[2 * tile + 0],
+                                                       b_qs[2 * tile + 1]);
+        ret = vdotq_laneq_s32(ret, signs, q0, tile);
+    }
+    for (int tile = 4; tile < 8; ++tile) {
+        const int8x16_t signs = ggml_q1_0_unpack_pair(b_qs[2 * tile + 0],
+                                                       b_qs[2 * tile + 1]);
+        ret = vdotq_laneq_s32(ret, signs, q1, tile - 4);
+    }
+    return ret;
+}
