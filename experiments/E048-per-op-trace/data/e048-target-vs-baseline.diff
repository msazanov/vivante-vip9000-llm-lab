+#include "e048-trace.h"
+
+#include "ggml.h"
+
+#include <errno.h>
+#include <inttypes.h>
+#include <limits.h>
+#include <stdatomic.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+
+#if defined(__linux__)
+#include <sched.h>
+#endif
+
+#define E048_DEFAULT_CAPACITY 4096u
+#define E048_MAX_CAPACITY 65536u
+#define E048_MAX_THREADS 64
+#define E048_PATH_MAX 1024
+
+enum e048_event_kind {
+    E048_EVENT_NODE = 1,
+    E048_EVENT_Q1 = 2,
+    E048_EVENT_PHASE = 3,
+};
+
+struct e048_event {
+    uint32_t kind;
+    uint32_t worker_ith;
+    uint64_t token_seq;
+    uint32_t node_index;
+    int32_t layer_index;
+    uint32_t fused_nodes;
+    uint32_t variant;
+    uint32_t phase;
+    uint32_t n;
+    uint32_t nr;
+    uint32_t nc;
+    int32_t cpu_start;
+    int32_t cpu_end;
+    uint64_t start_ns;
+    uint64_t end_ns;
+    uint64_t post_barrier_end_ns;
+    uint64_t logical_read;
+    uint64_t logical_write;
+    uint64_t unique_read;
+    uint64_t unique_write;
+    uint64_t q1_weight_read;
+    uint64_t q8_logical_read;
+    uint64_t q8_unique_read;
+    uint64_t output_write;
+    const struct ggml_tensor * node;
+};
+
+struct e048_ring {
+    struct e048_event * events;
+    uint32_t count;
+};
+
+struct ggml_e048_trace {
+    bool enabled;
+    bool token_active;
+    bool steady_decode;
+    FILE * output;
+    char path[E048_PATH_MAX];
+    int n_threads;
+    uint32_t capacity;
+    struct e048_ring rings[E048_MAX_THREADS];
+    atomic_uint overflow_count;
+    uint64_t token_seq;
+    uint32_t token_n_tokens;
+    uint64_t token_start_ns;
+    uint64_t token_end_ns;
+    int token_status;
+};
+
+struct e048_tls_context {
+    struct ggml_e048_trace * trace;
+    uint64_t token_seq;
+    uint32_t node_index;
+    int worker_ith;
+    const struct ggml_tensor * node;
+};
+
+static _Thread_local struct e048_tls_context e048_tls;
+
+uint64_t ggml_e048_trace_now_ns(void) {
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC_RAW, &ts);
+    return (uint64_t) ts.tv_sec * UINT64_C(1000000000) + (uint64_t) ts.tv_nsec;
+}
+
+struct ggml_e048_trace * ggml_e048_trace_current(void) {
+    return e048_tls.trace;
+}
+
+static uint32_t e048_env_capacity(void) {
+    const char * value = getenv("GGML_E048_TRACE_CAPACITY");
+    if (!value || !*value) {
+        return E048_DEFAULT_CAPACITY;
+    }
+    char * end = NULL;
+    unsigned long parsed = strtoul(value, &end, 10);
+    if (end == value || *end != '\0' || parsed < 256 || parsed > E048_MAX_CAPACITY) {
+        return E048_DEFAULT_CAPACITY;
+    }
+    return (uint32_t) parsed;
+}
+
+struct ggml_e048_trace * ggml_e048_trace_create_from_env(void) {
+    const char * path = getenv("GGML_E048_TRACE_PATH");
+    if (!path || !*path) {
+        return NULL;
+    }
+
+    struct ggml_e048_trace * trace = (struct ggml_e048_trace *) calloc(1, sizeof(*trace));
+    if (!trace) {
+        fprintf(stderr, "E048: trace state allocation failed\n");
+        return NULL;
+    }
+    trace->capacity = e048_env_capacity();
+    strncpy(trace->path, path, sizeof(trace->path) - 1);
+    trace->output = fopen(trace->path, "w");
+    if (!trace->output) {
+        fprintf(stderr, "E048: cannot open %s: %s\n", trace->path, strerror(errno));
+        free(trace);
+        return NULL;
+    }
+    trace->enabled = true;
+    atomic_init(&trace->overflow_count, 0);
+    return trace;
+}
+
+static void e048_free_rings(struct ggml_e048_trace * trace) {
+    for (int i = 0; i < E048_MAX_THREADS; ++i) {
+        free(trace->rings[i].events);
+        trace->rings[i].events = NULL;
+        trace->rings[i].count = 0;
+    }
+    trace->n_threads = 0;
+}
+
+void ggml_e048_trace_free(struct ggml_e048_trace * trace) {
+    if (!trace) {
+        return;
+    }
+    if (trace->output) {
+        fflush(trace->output);
+        fclose(trace->output);
+    }
+    e048_free_rings(trace);
+    free(trace);
+}
+
+void ggml_e048_trace_set_threads(struct ggml_e048_trace * trace, int n_threads) {
+    if (!trace || !trace->enabled) {
+        return;
+    }
+    if (n_threads < 1) {
+        n_threads = 1;
+    }
+    if (n_threads > E048_MAX_THREADS) {
+        n_threads = E048_MAX_THREADS;
+    }
+    if (trace->n_threads == n_threads) {
+        return;
+    }
+    if (trace->token_active) {
+        fprintf(stderr, "E048: refusing worker-ring resize during active token\n");
+        return;
+    }
+    e048_free_rings(trace);
+    for (int i = 0; i < n_threads; ++i) {
+        trace->rings[i].events = (struct e048_event *) calloc(trace->capacity, sizeof(struct e048_event));
+        if (!trace->rings[i].events) {
+            fprintf(stderr, "E048: ring allocation failed for worker %d\n", i);
+            e048_free_rings(trace);
+            return;
+        }
+    }
+    trace->n_threads = n_threads;
+}
+
+bool ggml_e048_trace_is_enabled(const struct ggml_e048_trace * trace) {
+    return trace && trace->enabled && trace->output != NULL;
+}
+
+uint64_t ggml_e048_trace_current_token_seq(const struct ggml_e048_trace * trace) {
+    return trace ? trace->token_seq : 0;
+}
+
+static void e048_emit_prefix(FILE * output, const char * event) {
+    fprintf(output, "{\"schema\":\"e048-trace/v1\",\"event\":\"%s\"", event);
+}
+
+static void e048_emit_token_begin(const struct ggml_e048_trace * trace) {
+    e048_emit_prefix(trace->output, "token_begin");
+    fprintf(trace->output, ",\"token_seq\":%" PRIu64 ",\"n_tokens\":%u,\"steady_decode\":%s,\"start_ns\":%" PRIu64 ",\"counter_method\":\"none\",\"observed_ddr_read_bytes\":null,\"observed_ddr_write_bytes\":null}\n",
+            trace->token_seq, trace->token_n_tokens, trace->steady_decode ? "true" : "false", trace->token_start_ns);
+    // The begin record is intentionally flushed before graph execution.  If
+    // the target process is killed or faults in an op, the JSONL still tells
+    // us that this token started, even though token_end is absent.
+    fflush(trace->output);
+}
+
+static void e048_emit_node_name(FILE * output, const struct ggml_tensor * node) {
+    const char * name = node ? ggml_get_name(node) : "";
+    fputs(",\"tensor_id\":\"", output);
+    for (const char * p = name; *p; ++p) {
+        if (*p == '\\' || *p == '"') {
+            fputc('\\', output);
+        }
+        fputc(*p, output);
+    }
+    fputc('"', output);
+    fprintf(output, ",\"op_name\":\"%s\"", node ? ggml_op_name(node->op) : "NONE");
+}
+
+void ggml_e048_trace_token_begin(struct ggml_e048_trace * trace, uint32_t n_tokens, bool steady_decode) {
+    if (!ggml_e048_trace_is_enabled(trace)) {
+        return;
+    }
+    if (trace->token_active) {
+        ggml_e048_trace_token_end(trace, -1);
+    }
+    trace->token_active = true;
+    trace->steady_decode = steady_decode;
+    trace->token_n_tokens = n_tokens;
+    trace->token_status = 0;
+    trace->token_start_ns = ggml_e048_trace_now_ns();
+    trace->token_end_ns = 0;
+    trace->token_seq++;
+    atomic_store_explicit(&trace->overflow_count, 0, memory_order_relaxed);
+    for (int i = 0; i < trace->n_threads; ++i) {
+        trace->rings[i].count = 0;
+    }
+    e048_emit_token_begin(trace);
+}
+
+static struct e048_event * e048_reserve(struct ggml_e048_trace * trace, int worker_ith) {
+    if (!ggml_e048_trace_is_enabled(trace) || worker_ith < 0 || worker_ith >= trace->n_threads) {
+        return NULL;
+    }
+    struct e048_ring * ring = &trace->rings[worker_ith];
+    if (ring->count >= trace->capacity) {
+        atomic_fetch_add_explicit(&trace->overflow_count, 1, memory_order_relaxed);
+        return NULL;
+    }
+    return &ring->events[ring->count++];
+}
+
+void ggml_e048_trace_set_op_context(
+        struct ggml_e048_trace * trace,
+        uint64_t token_seq,
+        uint32_t node_index,
+        int worker_ith,
+        const struct ggml_tensor * node) {
+    e048_tls.trace = trace;
+    e048_tls.token_seq = token_seq;
+    e048_tls.node_index = node_index;
+    e048_tls.worker_ith = worker_ith;
+    e048_tls.node = node;
+}
+
+int ggml_e048_trace_layer_index(const struct ggml_tensor * node) {
+    if (!node) {
+        return -1;
+    }
+    const char * name = ggml_get_name(node);
+    // llama.cpp transformer tensors conventionally carry ``blk.N``.  Keep a
+    // fallback for the older ``...-N`` names used by a few conversion tools.
+    const char * start = strstr(name, "blk.");
+    if (start) {
+        start += 4;
+    } else {
+        const char * dash = strrchr(name, '-');
+        start = dash && dash[1] ? dash + 1 : NULL;
+    }
+    if (!start || !*start) {
+        return -1;
+    }
+    char * end = NULL;
+    long value = strtol(start, &end, 10);
+    if (*end != '\0' || value < 0 || value > INT32_MAX) {
+        return -1;
+    }
+    return (int) value;
+}
+
+void ggml_e048_trace_record_node(
+        struct ggml_e048_trace * trace,
+        uint64_t token_seq,
+        uint32_t node_index,
+        int layer_index,
+        int worker_ith,
+        const struct ggml_tensor * node,
+        uint32_t fused_nodes,
+        uint64_t start_ns,
+        uint64_t end_ns,
+        uint64_t post_barrier_end_ns,
+        uint64_t logical_read,
+        uint64_t logical_write,
+        uint64_t unique_read,
+        uint64_t unique_write,
+        int cpu_start,
+        int cpu_end) {
+    struct e048_event * event = e048_reserve(trace, worker_ith);
+    if (!event) {
+        return;
+    }
+    event->kind = E048_EVENT_NODE;
+    event->worker_ith = (uint32_t) worker_ith;
+    event->token_seq = token_seq;
+    event->node_index = node_index;
+    event->layer_index = layer_index;
+    event->fused_nodes = fused_nodes;
+    event->cpu_start = cpu_start;
+    event->cpu_end = cpu_end;
+    event->start_ns = start_ns;
+    event->end_ns = end_ns;
+    event->post_barrier_end_ns = post_barrier_end_ns;
+    event->logical_read = logical_read;
+    event->logical_write = logical_write;
+    event->unique_read = unique_read;
+    event->unique_write = unique_write;
+    event->node = node;
+}
+
+void ggml_e048_trace_record_q1(struct ggml_e048_trace * trace, uint32_t variant, int n, int nr, int nc, void ** span_out) {
+    if (span_out) {
+        *span_out = NULL;
+    }
+    if (!trace || e048_tls.trace != trace) {
+        return;
+    }
+    struct e048_event * event = e048_reserve(trace, e048_tls.worker_ith);
+    if (!event) {
+        return;
+    }
+    const uint64_t blocks = (uint64_t) n / 128;
+    const uint64_t groups = (uint64_t) nc / 4;
+    event->kind = E048_EVENT_Q1;
+    event->worker_ith = (uint32_t) e048_tls.worker_ith;
+    event->token_seq = e048_tls.token_seq;
+    event->node_index = e048_tls.node_index;
+    event->variant = variant;
+    event->n = (uint32_t) n;
+    event->nr = (uint32_t) nr;
+    event->nc = (uint32_t) nc;
+    event->start_ns = ggml_e048_trace_now_ns();
+    event->cpu_start =
+#if defined(__linux__)
+        sched_getcpu();
+#else
+        -1;
+#endif
+    event->q1_weight_read = blocks * groups * 72;
+    event->q8_logical_read = blocks * groups * 4 * 34;
+    event->q8_unique_read = blocks * 4 * 34;
+    event->output_write = (uint64_t) nc * 4;
+    event->node = e048_tls.node;
+    if (span_out) {
+        *span_out = event;
+    }
+}
+
+void ggml_e048_trace_finish_q1(void * span) {
+    if (!span) {
+        return;
+    }
+    struct e048_event * event = (struct e048_event *) span;
+    event->end_ns = ggml_e048_trace_now_ns();
+    event->cpu_end =
+#if defined(__linux__)
+        sched_getcpu();
+#else
+        -1;
+#endif
+}
+
+void ggml_e048_trace_record_phase(
+        struct ggml_e048_trace * trace,
+        uint32_t phase,
+        uint64_t start_ns,
+        uint64_t end_ns,
+        int cpu_start,
+        int cpu_end) {
+    if (!trace || e048_tls.trace != trace) {
+        return;
+    }
+    struct e048_event * event = e048_reserve(trace, e048_tls.worker_ith);
+    if (!event) {
+        return;
+    }
+    event->kind = E048_EVENT_PHASE;
+    event->worker_ith = (uint32_t) e048_tls.worker_ith;
+    event->token_seq = e048_tls.token_seq;
+    event->node_index = e048_tls.node_index;
+    event->phase = phase;
+    event->start_ns = start_ns;
+    event->end_ns = end_ns;
+    event->cpu_start = cpu_start;
+    event->cpu_end = cpu_end;
+    event->node = e048_tls.node;
+}
+
+static void e048_emit_events(struct ggml_e048_trace * trace) {
+    if (!trace->output) {
+        return;
+    }
+    for (int worker = 0; worker < trace->n_threads; ++worker) {
+        const struct e048_ring * ring = &trace->rings[worker];
+        for (uint32_t i = 0; i < ring->count; ++i) {
+            const struct e048_event * event = &ring->events[i];
+            if (event->kind == E048_EVENT_NODE) {
+                e048_emit_prefix(trace->output, "node_worker");
+                fprintf(trace->output, ",\"token_seq\":%" PRIu64 ",\"node_index\":%u,\"layer_index\":%d,\"worker_ith\":%u,\"fused_nodes\":%u",
+                        event->token_seq, event->node_index, event->layer_index, event->worker_ith, event->fused_nodes);
+                e048_emit_node_name(trace->output, event->node);
+                fprintf(trace->output, ",\"start_ns\":%" PRIu64 ",\"end_ns\":%" PRIu64 ",\"post_barrier_end_ns\":%" PRIu64 ",\"cpu_start\":%d,\"cpu_end\":%d,\"logical_read_bytes\":%" PRIu64 ",\"logical_write_bytes\":%" PRIu64 ",\"unique_read_bytes\":%" PRIu64 ",\"unique_write_bytes\":%" PRIu64 ",\"observed_ddr_read_bytes\":null,\"observed_ddr_write_bytes\":null,\"counter_method\":\"none\"}\n",
+                        event->start_ns, event->end_ns, event->post_barrier_end_ns, event->cpu_start, event->cpu_end,
+                        event->logical_read, event->logical_write, event->unique_read, event->unique_write);
+            } else if (event->kind == E048_EVENT_Q1) {
+                e048_emit_prefix(trace->output, "q1_kernel");
+                fprintf(trace->output, ",\"token_seq\":%" PRIu64 ",\"node_index\":%u,\"worker_ith\":%u,\"variant\":\"q1_0_4x%u_q8_0\",\"n\":%u,\"nr\":%u,\"nc\":%u,\"start_ns\":%" PRIu64 ",\"end_ns\":%" PRIu64 ",\"cpu_start\":%d,\"cpu_end\":%d,\"q1_packed_weight_read_bytes\":%" PRIu64 ",\"q8_activation_logical_read_bytes\":%" PRIu64 ",\"q8_activation_unique_read_bytes\":%" PRIu64 ",\"output_write_bytes\":%" PRIu64 ",\"observed_ddr_read_bytes\":null,\"observed_ddr_write_bytes\":null,\"counter_method\":\"none\"}\n",
+                        event->token_seq, event->node_index, event->worker_ith, event->variant, event->n, event->nr, event->nc,
+                        event->start_ns, event->end_ns, event->cpu_start, event->cpu_end, event->q1_weight_read, event->q8_logical_read, event->q8_unique_read, event->output_write);
+            } else if (event->kind == E048_EVENT_PHASE) {
+                e048_emit_prefix(trace->output, "phase_worker");
+                fprintf(trace->output, ",\"token_seq\":%" PRIu64 ",\"node_index\":%u,\"worker_ith\":%u,\"phase\":\"%s\",\"start_ns\":%" PRIu64 ",\"end_ns\":%" PRIu64 ",\"cpu_start\":%d,\"cpu_end\":%d,\"observed_ddr_read_bytes\":null,\"observed_ddr_write_bytes\":null,\"counter_method\":\"none\"}\n",
+                        event->token_seq, event->node_index, event->worker_ith,
+                        event->phase == 1 ? "f32_to_q8" : "unknown", event->start_ns, event->end_ns, event->cpu_start, event->cpu_end);
+            }
+        }
+    }
+
+    e048_emit_prefix(trace->output, "token_end");
+    fprintf(trace->output, ",\"token_seq\":%" PRIu64 ",\"end_ns\":%" PRIu64 ",\"status\":%d,\"overflow_count\":%u,\"counter_method\":\"none\",\"observed_ddr_read_bytes\":null,\"observed_ddr_write_bytes\":null}\n",
+            trace->token_seq, trace->token_end_ns, trace->token_status,
+            atomic_load_explicit(&trace->overflow_count, memory_order_relaxed));
+    fflush(trace->output);
+}
+
+void ggml_e048_trace_token_end(struct ggml_e048_trace * trace, int status) {
+    if (!ggml_e048_trace_is_enabled(trace) || !trace->token_active) {
+        return;
+    }
+    trace->token_status = status;
+    trace->token_end_ns = ggml_e048_trace_now_ns();
+    e048_emit_events(trace);
+    trace->token_active = false;
+}
+
+static uint64_t e048_union_ranges(const struct ggml_tensor * node, bool source) {
+    struct {
+        uintptr_t start;
+        uintptr_t end;
+    } ranges[GGML_MAX_SRC + 1];
+    int count = 0;
+    if (source) {
+        for (int i = 0; i < GGML_MAX_SRC; ++i) {
+            const struct ggml_tensor * src = node->src[i];
+            if (!src || !src->data || ggml_nbytes(src) == 0) {
+                continue;
+            }
+            ranges[count].start = (uintptr_t) src->data;
+            ranges[count].end = ranges[count].start + ggml_nbytes(src);
+            count++;
+        }
+    } else if (node->data && ggml_nbytes(node) > 0) {
+        ranges[0].start = (uintptr_t) node->data;
+        ranges[0].end = ranges[0].start + ggml_nbytes(node);
+        count = 1;
+    }
+    for (int i = 1; i < count; ++i) {
+        const uintptr_t start = ranges[i].start;
+        const uintptr_t end = ranges[i].end;
+        int j = i - 1;
+        while (j >= 0 && ranges[j].start > start) {
+            ranges[j + 1] = ranges[j];
+            --j;
+        }
+        ranges[j + 1].start = start;
+        ranges[j + 1].end = end;
+    }
+    uint64_t total = 0;
+    uintptr_t start = 0;
+    uintptr_t end = 0;
+    bool active = false;
+    for (int i = 0; i < count; ++i) {
+        if (!active) {
+            start = ranges[i].start;
+            end = ranges[i].end;
+            active = true;
+        } else if (ranges[i].start <= end) {
+            if (ranges[i].end > end) {
+                end = ranges[i].end;
+            }
+        } else {
+            total += (uint64_t) (end - start);
+            start = ranges[i].start;
+            end = ranges[i].end;
+        }
+    }
+    if (active) {
+        total += (uint64_t) (end - start);
+    }
+    return total;
+}
+
+void ggml_e048_trace_node_bytes(
+        const struct ggml_tensor * node,
+        uint64_t * logical_read,
+        uint64_t * logical_write,
+        uint64_t * unique_read,
+        uint64_t * unique_write) {
+    uint64_t read = 0;
+    for (int i = 0; i < GGML_MAX_SRC; ++i) {
+        if (node->src[i]) {
+            read += ggml_nbytes(node->src[i]);
+        }
+    }
+    *logical_read = read;
+    *logical_write = ggml_nbytes(node);
+    *unique_read = e048_union_ranges(node, true);
+    *unique_write = e048_union_ranges(node, false);
+}
