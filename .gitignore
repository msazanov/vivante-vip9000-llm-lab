# Public artifact policy
# Public weights, binaries, NBGs, custom kernels/source, SDK or kernel
# patches, and NPU tools may be published when redistributable and listed in
# docs/experiments/public-artifact-manifest.json. Personal/sensitive data,
# including tokens, passwords, logins, private keys, identifiers, and
# credentials, is prohibited. These rules do not automatically track existing
# payloads or alter raw historical evidence.

# Local/private material and secret-bearing files
.env
.env.*
!.env.example
*.pem
*.key
*.token
# Build outputs (public source and explicitly manifested build products are
# not ignored by artifact type; only local build directories are ignored).
build/
cmake-build-*/
CMakeFiles/
CMakeCache.txt

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Benchmark scratch data
benchmarks/results/local/
experiments/**/results/local/
benchmarks/results/.*.lock
benchmarks/results/.*.tmp
benchmarks/results/.*.backup
benchmarks/models/.*.tmp

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
