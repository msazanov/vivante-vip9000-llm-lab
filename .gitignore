# Proprietary/vendor assets
vendor/
sdk/
models/
artifacts/private/

# Generated accelerator artifacts
*.nb
*.nbg
*.bin
*.blob

# E055 raw phases seal only these reviewed harness executable names. Other
# binaries remain ignored, including other files beneath the same raw phase.
!experiments/E055-q1-hot-cold/raw/*/artifacts/harness-O3.bin
!experiments/E055-q1-hot-cold/raw/*/artifacts/harness-O3-flto.bin

# Native binaries and libraries
*.so
*.so.*
*.a
*.ko
*.o
*.out

# Build outputs
build/
cmake-build-*/
CMakeFiles/
CMakeCache.txt

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Local environment and secrets
.env
.env.*
!.env.example
*.pem
*.key
*.token

# Models and large tensor files
*.gguf
*.safetensors
*.onnx
*.tflite
*.npy
*.npz
*.pt
*.pth

# Benchmark scratch data
benchmarks/results/local/
experiments/**/results/local/
benchmarks/results/.*.lock
benchmarks/results/.*.tmp
benchmarks/results/.*.backup
benchmarks/models/.*.tmp

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

